# Allowlist model: ignore EVERYTHING by default...
/*

# ...then re-include ONLY the files GitHub Pages needs to serve the site.
# To make another file public later, add a line like:  !/newfile.html
!/.gitignore
!/index.html
!/privacy.html
!/terms.html
!/CNAME
!/README.md
!/favicon.svg
!/favicon-32.png
!/apple-touch-icon.png
!/assets/
!/blog/
!/.nojekyll
